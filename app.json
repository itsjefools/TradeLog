{
  "expo": {
    "name": "TradeLog",
    "slug": "TradeLog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tradelog",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kingjay.tradelog",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "プロフィール画像や取引のチャート画像を撮影するためにカメラを使用します。",
        "NSPhotoLibraryUsageDescription": "プロフィール画像や取引のチャート画像を選択するために写真ライブラリにアクセスします。"
      }
    },
    "android": {
      "package": "com.kingjay.tradelog",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "投稿に写真を添付するためにフォトライブラリへのアクセスが必要です。",
          "cameraPermission": "投稿の写真を撮影するためにカメラへのアクセスが必要です。"
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "壁紙をカメラロールに保存するために写真へのアクセスが必要です。",
          "savePhotosPermission": "壁紙をカメラロールに保存するために写真へのアクセスが必要です。",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ],
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      "./plugins/withModularHeaders"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "96a8351f-717e-4983-8723-8ddb5ae3c810"
      }
    },
    "owner": "jeff_souza",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/96a8351f-717e-4983-8723-8ddb5ae3c810"
    }
  }
}
